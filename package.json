{
  "name": "sheetgl",
  "version": "2.0.3",
  "description": "High-performance WebGL & Canvas Excel DataGrid for React with viewport virtualization, 21 column types, DevExtreme-style batch CRUD & cascading triggers, and zero dependencies. MIT licensed.",
  "license": "MIT",
  "author": "SheetGL Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umitunc/sheetgl.git"
  },
  "bugs": {
    "url": "https://github.com/umitunc/sheetgl/issues"
  },
  "homepage": "https://github.com/umitunc/sheetgl#readme",
  "keywords": [
    "datagrid",
    "webgl-datagrid",
    "canvas-datagrid",
    "excel-datagrid",
    "devextreme-datagrid",
    "react",
    "spreadsheet",
    "virtualized-grid",
    "data-table",
    "high-performance"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "sheetgl": "bin/cli.mjs",
    "create-sheetgl": "bin/cli.mjs"
  },
  "main": "./dist/lib/sheetgl.cjs",
  "module": "./dist/lib/sheetgl.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/sheetgl.js",
      "require": "./dist/lib/sheetgl.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build": "npm run build:demo && npm run build:lib",
    "prepublishOnly": "npm run build:lib",
    "cli": "node ./bin/cli.mjs",
    "doctor": "node ./bin/cli.mjs doctor",
    "pack:check": "npm pack --dry-run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.60.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
